--- a/usr/src/sys/arch/sh5/sh5/in_cksum.S	2005-01-29 11:22:30.000000000 +0000
+++ b/usr/src/sys/arch/sh5/sh5/in_cksum.S	2026-11-02 13:40:25.929418711 +0000
@@ -313,8 +313,16 @@
 #endif
 	ldlo.q	r4, IP_SRC, r19		/* Note: Assumes ip_src/ip_dst are */
 	ldhi.q	r4, IP_SRC+7, r20	/*       contiguous in memory */
-	or	r19, r20, r19
-	ADDC	(r19, r2, r2)		/* sum += ip->ip_{src,dst} */
+	/*
+	 * Fold the destination address down from bits 63:32 before adding.
+	 * The running sum in r2 is added to with plain adds later on, so it
+	 * must not be allowed to get within 2^33 of overflowing; with an
+	 * unfolded broadcast address it would (udps_badsum on every
+	 * broadcast UDP packet).
+	 */
+	mshfhi.l r20, r63, r20
+	add	r19, r2, r2		/* sum += ip->ip_src */
+	add	r20, r2, r2		/* sum += ip->ip_dst */
 	movi	0, r3
 #endif	/* INET */
 
