--- a/usr/src/sys/arch/sh5/include/vmparam.h	2005-09-30 08:50:32.000000000 +0000
+++ b/usr/src/sys/arch/sh5/include/vmparam.h	2026-11-02 15:33:19.501278846 +0000
@@ -116,7 +116,17 @@
  * USRSTACK is the top of user stack. 
  */
 #define USRSTACK	VM_MAXUSER_ADDRESS
+#ifdef _LP64
+/*
+ * Keep 32-bit processes below 2GB: effective addresses are sign-extended
+ * from bit 31, so a 32-bit address above 0x80000000 would fall outside
+ * the process map when the kernel sees it in TEA.
+ */
+#define VM_MAXUSER_ADDRESS32	(0x80000000UL - PAGE_SIZE)
+#define USRSTACK32	VM_MAXUSER_ADDRESS32
+#else
 #define USRSTACK32	((u_int32_t)USRSTACK)
+#endif
 
 /* Virtual memory resoruce limit. */
 #define MAXTSIZ                 (64 * 1024 * 1024)      /* max text size */
