diff --git a/tools/include/nolibc/arch-sh.h b/tools/include/nolibc/arch-sh.h
index a32378fd621f..d8c34c04e151 100644
--- a/tools/include/nolibc/arch-sh.h
+++ b/tools/include/nolibc/arch-sh.h
@@ -10,6 +10,164 @@
 #include "compiler.h"
 #include "crt.h"
 
+#if defined(__SH5__) && defined(__SHMEDIA__)
+/*
+ * Syscalls for SH-5 in SHmedia mode (sh64):
+ *   - registers are 64bit wide, the ABI is ILP32 with sign-extended values
+ *   - syscall number is passed in r9 and in the trap value
+ *   - arguments are in r2, r3, r4, r5, r6, r7
+ *   - the system call is performed by trapa Rn with Rn holding
+ *     0x100000 | (number of arguments << 16) | syscall number
+ *   - syscall return value is in r9
+ */
+
+#define __nolibc_sh5_trap(nargs, num) (0x100000 | ((nargs) << 16) | (num))
+
+#define __nolibc_syscall0(num)                                                \
+({                                                                            \
+	register long _num __asm__ ("r9") = (num);                            \
+	register long _tra __asm__ ("r0") = __nolibc_sh5_trap(0, num);        \
+									      \
+	__asm__ volatile (                                                    \
+		"trapa %1"                                                    \
+		: "+r"(_num)                                                  \
+		: "r"(_tra)                                                   \
+		: "memory", "cc"                                              \
+	);                                                                    \
+	_num;                                                                 \
+})
+
+#define __nolibc_syscall1(num, arg1)                                          \
+({                                                                            \
+	register long _num __asm__ ("r9") = (num);                            \
+	register long _tra __asm__ ("r0") = __nolibc_sh5_trap(1, num);        \
+	register long _arg1 __asm__ ("r2") = (long)(arg1);                    \
+									      \
+	__asm__ volatile (                                                    \
+		"trapa %1"                                                    \
+		: "+r"(_num)                                                  \
+		: "r"(_tra), "r"(_arg1)                                       \
+		: "memory", "cc"                                              \
+	);                                                                    \
+	_num;                                                                 \
+})
+
+#define __nolibc_syscall2(num, arg1, arg2)                                    \
+({                                                                            \
+	register long _num __asm__ ("r9") = (num);                            \
+	register long _tra __asm__ ("r0") = __nolibc_sh5_trap(2, num);        \
+	register long _arg1 __asm__ ("r2") = (long)(arg1);                    \
+	register long _arg2 __asm__ ("r3") = (long)(arg2);                    \
+									      \
+	__asm__ volatile (                                                    \
+		"trapa %1"                                                    \
+		: "+r"(_num)                                                  \
+		: "r"(_tra), "r"(_arg1), "r"(_arg2)                           \
+		: "memory", "cc"                                              \
+	);                                                                    \
+	_num;                                                                 \
+})
+
+#define __nolibc_syscall3(num, arg1, arg2, arg3)                              \
+({                                                                            \
+	register long _num __asm__ ("r9") = (num);                            \
+	register long _tra __asm__ ("r0") = __nolibc_sh5_trap(3, num);        \
+	register long _arg1 __asm__ ("r2") = (long)(arg1);                    \
+	register long _arg2 __asm__ ("r3") = (long)(arg2);                    \
+	register long _arg3 __asm__ ("r4") = (long)(arg3);                    \
+									      \
+	__asm__ volatile (                                                    \
+		"trapa %1"                                                    \
+		: "+r"(_num)                                                  \
+		: "r"(_tra), "r"(_arg1), "r"(_arg2), "r"(_arg3)               \
+		: "memory", "cc"                                              \
+	);                                                                    \
+	_num;                                                                 \
+})
+
+#define __nolibc_syscall4(num, arg1, arg2, arg3, arg4)                        \
+({                                                                            \
+	register long _num __asm__ ("r9") = (num);                            \
+	register long _tra __asm__ ("r0") = __nolibc_sh5_trap(4, num);        \
+	register long _arg1 __asm__ ("r2") = (long)(arg1);                    \
+	register long _arg2 __asm__ ("r3") = (long)(arg2);                    \
+	register long _arg3 __asm__ ("r4") = (long)(arg3);                    \
+	register long _arg4 __asm__ ("r5") = (long)(arg4);                    \
+									      \
+	__asm__ volatile (                                                    \
+		"trapa %1"                                                    \
+		: "+r"(_num)                                                  \
+		: "r"(_tra), "r"(_arg1), "r"(_arg2), "r"(_arg3), "r"(_arg4)   \
+		: "memory", "cc"                                              \
+	);                                                                    \
+	_num;                                                                 \
+})
+
+#define __nolibc_syscall5(num, arg1, arg2, arg3, arg4, arg5)                  \
+({                                                                            \
+	register long _num __asm__ ("r9") = (num);                            \
+	register long _tra __asm__ ("r0") = __nolibc_sh5_trap(5, num);        \
+	register long _arg1 __asm__ ("r2") = (long)(arg1);                    \
+	register long _arg2 __asm__ ("r3") = (long)(arg2);                    \
+	register long _arg3 __asm__ ("r4") = (long)(arg3);                    \
+	register long _arg4 __asm__ ("r5") = (long)(arg4);                    \
+	register long _arg5 __asm__ ("r6") = (long)(arg5);                    \
+									      \
+	__asm__ volatile (                                                    \
+		"trapa %1"                                                    \
+		: "+r"(_num)                                                  \
+		: "r"(_tra), "r"(_arg1), "r"(_arg2), "r"(_arg3), "r"(_arg4),  \
+		  "r"(_arg5)                                                  \
+		: "memory", "cc"                                              \
+	);                                                                    \
+	_num;                                                                 \
+})
+
+#define __nolibc_syscall6(num, arg1, arg2, arg3, arg4, arg5, arg6)            \
+({                                                                            \
+	register long _num __asm__ ("r9") = (num);                            \
+	register long _tra __asm__ ("r0") = __nolibc_sh5_trap(6, num);        \
+	register long _arg1 __asm__ ("r2") = (long)(arg1);                    \
+	register long _arg2 __asm__ ("r3") = (long)(arg2);                    \
+	register long _arg3 __asm__ ("r4") = (long)(arg3);                    \
+	register long _arg4 __asm__ ("r5") = (long)(arg4);                    \
+	register long _arg5 __asm__ ("r6") = (long)(arg5);                    \
+	register long _arg6 __asm__ ("r7") = (long)(arg6);                    \
+									      \
+	__asm__ volatile (                                                    \
+		"trapa %1"                                                    \
+		: "+r"(_num)                                                  \
+		: "r"(_tra), "r"(_arg1), "r"(_arg2), "r"(_arg3), "r"(_arg4),  \
+		  "r"(_arg5), "r"(_arg6)                                      \
+		: "memory", "cc"                                              \
+	);                                                                    \
+	_num;                                                                 \
+})
+
+#ifndef NOLIBC_NO_RUNTIME
+/* startup code */
+void _start_wrapper(void);
+void __attribute__((weak, noreturn)) __nolibc_entrypoint __nolibc_no_stack_protector _start_wrapper(void)
+{
+	__asm__ volatile (
+		".balign 4\n"
+		".global _start\n"           /* The C function will have a prologue,         */
+		".type _start, @function\n"  /* corrupting "sp"                              */
+		".weak _start\n"
+		"_start:\n"
+
+		"add r15, r63, r2\n"         /* save argc pointer to r2, as arg1 of _start_c */
+		"pt _start_c, tr0\n"
+		"blink tr0, r18\n"           /* transfer to c runtime                        */
+
+		".size _start, .-_start\n"
+	);
+	__nolibc_entrypoint_epilogue();
+}
+#endif /* NOLIBC_NO_RUNTIME */
+
+#else /* SHcompact */
+
 /*
  * Syscalls for SuperH:
  *   - registers are 32bit wide
@@ -161,4 +319,6 @@ void __attribute__((weak, noreturn)) __nolibc_entrypoint __nolibc_no_stack_prote
 }
 #endif /* NOLIBC_NO_RUNTIME */
 
+#endif /* SHcompact */
+
 #endif /* _NOLIBC_ARCH_SH_H */
